# AutoTube AI Environment Configuration
# Zero recurring investment - Free & open-source stack

# YouTube API Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secret.json
YOUTUBE_TOKEN_FILE=token.json

# Default Publishing Settings
DEFAULT_PRIVACY=private
DEFAULT_CATEGORY_ID=24
TIMEZONE=Asia/Kolkata

# Whisper AI Model (Runs 100% locally on CPU without paid APIs)
# Options: tiny, base, small, medium
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Video Defaults (YouTube Shorts 9:16)
TARGET_WIDTH=1080
TARGET_HEIGHT=1920
MIN_CLIP_DURATION=15.0
MAX_CLIP_DURATION=60.0
DEFAULT_CLIP_DURATION=35.0
MAX_CLIPS_PER_VIDEO=5
CROP_MODE=smart
KARAOKE_ENABLED=true
NORMALIZE_AUDIO=true
BG_MUSIC_VOLUME=0.12
